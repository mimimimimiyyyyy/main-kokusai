# 技能伝承動画共有機能（skill_transfer_cell.py）の設定。
# Colabではシークレット（左の鍵アイコン）に OPENAI_API_KEY / NGROK_AUTH_TOKEN（Claudeを使うなら ANTHROPIC_API_KEY）を
# 登録すれば自動で読み込まれる。それ以外の値は、必要に応じてセルの先頭で os.environ["..."] = "..." と設定するか、
# /content/.env に書く。

# --- 秘密情報 ---
OPENAI_API_KEY=
NGROK_AUTH_TOKEN=
# SKILL_LLM_PROVIDER=anthropic のときだけ必要
ANTHROPIC_API_KEY=

# --- LLM ---
# openai（既定。gpt-4o）または anthropic
SKILL_LLM_PROVIDER=openai
# 空欄なら openai は gpt-4o、anthropic は claude-opus-5-5
SKILL_LLM_MODEL=

# --- 保存先（Google Drive） ---
SKILL_MEDIA_DIR=/content/drive/MyDrive/skill_transfer
# 空欄なら SKILL_MEDIA_DIR/skill_transfer.db（対話研究の corpus.db とは別のファイル）
# SKILL_DB_PATH=/content/drive/MyDrive/skill_transfer/skill_transfer.db
# タグ一覧の初期データを別のCSVにしたいときだけ指定（空欄ならセルに入っている初期データ）
# SKILL_SEED_CSV=/content/drive/MyDrive/skill_transfer/skill_transfer_tags.csv

# --- サーバー ---
SKILL_PORT=8000

# --- 字幕 ---
SKILL_SUBTITLE_MAX_CHARS=20
SKILL_SUBTITLE_MAX_LINES=2

# --- 音声認識 ---
SKILL_WHISPER_MODEL=medium
SKILL_WHISPER_LANGUAGE=ja

# --- タグ付け ---
# タグ一覧との文字列の類似度（0〜100）。これ以上なら同じタグとみなす
SKILL_TAG_FUZZY_THRESHOLD=85
# 手順の数・注意点の数から難易度タグを付ける
SKILL_DIFFICULTY_TAG=false

# --- 匿名化（人名・会社名・現場名などを[MASK]に置き換えるか） ---
SKILL_ANONYMIZE=false
