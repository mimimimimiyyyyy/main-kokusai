# 技能伝承動画共有機能（skill_transfer_cell.py）の設定。
# Colabではシークレット（左の鍵アイコン）に OPENAI_API_KEY / ANTHROPIC_API_KEY を登録すれば自動で読み込まれる。
# それ以外の値は、必要に応じてセルの先頭で os.environ["..."] = "..." と設定するか、.env に書く。

# --- 秘密情報 ---
OPENAI_API_KEY=
# SKILL_LLM_PROVIDER=anthropic のときだけ必要
ANTHROPIC_API_KEY=

# --- LLM ---
# openai（既定。既存セルと同じ）または anthropic
SKILL_LLM_PROVIDER=openai
# 空欄なら openai は gpt-4o（既存と同じ）、anthropic は claude-opus-5-5
SKILL_LLM_MODEL=

# --- 保存先（Google Drive） ---
SKILL_MEDIA_DIR=/content/drive/MyDrive/skill_transfer
# SKILL_SEED_CSV=/content/drive/MyDrive/skill_transfer/seed/skill_transfer_tags.csv
# SKILL_HTML_PATH=/content/drive/MyDrive/skill_transfer/skill_transfer.html

# --- 字幕 ---
SKILL_SUBTITLE_MAX_CHARS=20
SKILL_SUBTITLE_MAX_LINES=2

# --- 音声認識 ---
SKILL_WHISPER_LANGUAGE=ja

# --- タグ付け ---
# タグ一覧との文字列の類似度（0〜100）。これ以上なら同じタグとみなす
SKILL_TAG_FUZZY_THRESHOLD=85
# 手順の数・注意点の数から難易度タグを付ける
SKILL_DIFFICULTY_TAG=false

# --- 匿名化（既存の[MASK]置換を技能伝承にもかけるか） ---
SKILL_ANONYMIZE=false
